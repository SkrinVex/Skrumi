// Самостоятельный пример нового API; не исходная игра moon_forest.skm.
// Стрелки/WASD — движение, Space — вспышка, P — пауза, Esc — выход.
using graphics;
using math;
using game;

void main() {
    random_seed(2026);
    int background = create_canvas(800, 500);
    draw_to_canvas(background);
    draw_gradient(0, 0, 800, 500, 0x10152C, 0x243E4B, true);
    for (int i = 0; i < 100; i++) {
        int x = random(0, 799);
        int y = random(0, 330);
        draw_circle_alpha(x, y, 1, 0xE3E5C8, random(80, 200));
    }
    draw_circle_alpha(620, 105, 65, 0x8BB8C8, 18);
    draw_circle_alpha(620, 105, 50, 0xC4D9CF, 25);
    draw_circle(620, 105, 32, 0xE1E7CF);
    draw_circle(632, 96, 29, 0x172035);
    for (int i = 0; i < 24; i++) {
        int x = i * 36 - 20;
        int top = random(180, 270);
        draw_rect(x - 4, top + 60, 8, 170, 0x132C35);
        draw_triangle(x, top, x - 50, top + 140, x + 50, top + 140, 0x152F39);
        draw_triangle(x, top + 45, x - 65, top + 190, x + 65, top + 190, 0x183741);
    }
    draw_gradient(0, 390, 800, 110, 0x24474B, 0x142C35, true);
    draw_to_canvas(0);
    open_window(800, 500, "Skrumi • Лунная поляна");
    set_window_resizable(false);
    set_target_fps(60);
    array<Particle> sparks = particle_pool(256);
    Interval emission = Interval(0.035);
    Vec2 hero = Vec2(400.0, 385.0);
    float time = 0.0;
    bool paused = false;
    int frames = 0;
    int limit = env_get("SKRUMI_DEMO_FRAMES") == "" ? 0 : to_int(env_get("SKRUMI_DEMO_FRAMES"));
    while (window_poll()) {
        if (key_pressed("ESCAPE")) { break; }
        if (key_pressed("P")) { paused = !paused; }
        if (!window_focused() && limit == 0) { paused = true; }
        float dt = frame_delta();
        if (!paused) {
            time += dt;
            float dx = (key_down("RIGHT") || key_down("D") ? 1.0 : 0.0) - (key_down("LEFT") || key_down("A") ? 1.0 : 0.0);
            float dy = (key_down("DOWN") || key_down("S") ? 1.0 : 0.0) - (key_down("UP") || key_down("W") ? 1.0 : 0.0);
            Vec2 direction = Vec2(dx, dy).normalized();
            hero.x = clamp(hero.x + direction.x * dt * 160.0, 20.0, 780.0);
            hero.y = clamp(hero.y + direction.y * dt * 160.0, 300.0, 465.0);
            int count = emission.update(dt);
            if (key_pressed("SPACE")) { count += 36; }
            for (int i = 0; i < count; i++) {
                spawn_particle(sparks, hero.x, hero.y - 10.0, random_range(-45.0, 45.0), random_range(-80.0, -15.0),
                    random_range(0.8, 2.0), 0xFFBE6B, random(1, 3));
            }
            update_particles(sparks, dt);
        }
        draw_canvas(background, 0, 0);
        for (int i = 0; i < 18; i++) {
            int x = to_int(30.0 + i * 43.0 + sin(time + i) * 8.0);
            int y = to_int(350.0 + sin(time * 0.8 + i * 1.7) * 35.0);
            draw_circle_alpha(x, y, 7, 0xB6DB8E, 12);
            draw_circle_alpha(x, y, 1, 0xD7ECA4, 190);
        }
        int hx = to_int(hero.x);
        int hy = to_int(hero.y);
        draw_ellipse(hx, hy + 8, 16, 4, 0x102A31);
        draw_circle_alpha(hx, hy - 6, 42, 0xF5AF62, 12);
        draw_circle_alpha(hx, hy - 6, 26, 0xF5AF62, 24);
        draw_triangle(hx, hy - 25, hx - 10, hy + 6, hx + 10, hy + 6, 0xD99C69);
        draw_circle(hx, hy - 19, 5, 0xF5D4A0);
        draw_particles(sparks);
        draw_text(28, 27, "ЛУННАЯ ПОЛЯНА", 3, 0xE1E7CF);
        draw_text_alpha(30, 64, "SKRUMI  •  СВЕТ И ТИШИНА", 1, 0xB5C9C8, 185);
        draw_rect_alpha(20, 450, 760, 32, 0x0D1F2C, 190);
        draw_text(32, 461, "WASD / стрелки — идти   SPACE — искры   P — пауза   ESC — выход", 1, 0xC6D9CB);
        if (paused) {
            draw_rect_alpha(0, 0, 800, 500, 0x081423, 160);
            draw_text_aligned(400, 220, "ПАУЗА", 4, 0xE1E7CF, "center");
            draw_text_aligned(400, 270, "Нажмите P", 2, 0xB5C9C8, "center");
        }
        present_window();
        frames++;
        if (limit > 0 && frames >= limit) {
            string screenshot = env_get("SKRUMI_DEMO_SCREENSHOT");
            if (screenshot != "") { save_screenshot(screenshot); }
            break;
        }
    }
    close_window();
    free_canvas(background);
}
main();
