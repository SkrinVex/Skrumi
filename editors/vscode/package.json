{
  "name": "skrumi-language",
  "displayName": "Skrumi Programming Language",
  "description": "Официальная поддержка языка Skrumi для VS Code: подсветка, LSP (диагностика по всему проекту, автодополнение, наведение, переход к определению, подсказки параметров), отладчик (точки останова, шаги, переменные, консоль), запуск, проверка и сборка программ",
  "version": "10.0.0",
  "publisher": "SkrinVex",
  "license": "MIT",
  "homepage": "https://github.com/SkrinVex/Skrumi",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkrinVex/Skrumi.git"
  },
  "bugs": {
    "url": "https://github.com/SkrinVex/Skrumi/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "skrumi",
    "language server",
    "lsp",
    "debugger"
  ],
  "activationEvents": [
    "onLanguage:skrumi",
    "onCommand:skrumi.run",
    "onCommand:skrumi.check",
    "onCommand:skrumi.build",
    "onCommand:skrumi.chooseEntry",
    "onCommand:skrumi.debug",
    "onDebugResolve:skrumi",
    "onDebugDynamicConfigurations:skrumi"
  ],
  "main": "./client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "skrumi",
        "aliases": [
          "Skrumi",
          "skrumi"
        ],
        "extensions": [
          ".skm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skrumi",
        "scopeName": "source.skm",
        "path": "./syntaxes/skrumi.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Skrumi",
      "properties": {
        "skrumi.lsp.serverPath": {
          "type": "string",
          "default": "skrumi-lsp",
          "description": "Путь к исполняемому файлу skrumi-lsp (по умолчанию ищется в PATH)."
        },
        "skrumi.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Уровень трассировки сообщений между VS Code и skrumi-lsp."
        },
        "skrumi.run.executablePath": {
          "type": "string",
          "default": "skrumi",
          "description": "Путь к исполняемому файлу skrumi для запуска, проверки и сборки (по умолчанию ищется в build/ проекта, ~/.local/bin и PATH)."
        },
        "skrumi.run.entryFile": {
          "type": "string",
          "default": "",
          "description": "Главный файл программы относительно папки проекта. Пусто — запускается открытый файл. Удобно, когда main.skm подключает остальные файлы."
        },
        "skrumi.run.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Аргументы командной строки программы (os_args())."
        }
      }
    },
    "commands": [
      {
        "command": "skrumi.run",
        "title": "Skrumi: запустить программу",
        "category": "Skrumi",
        "icon": "$(play)"
      },
      {
        "command": "skrumi.debug",
        "title": "Skrumi: отладить программу",
        "category": "Skrumi",
        "icon": "$(debug-alt)"
      },
      {
        "command": "skrumi.check",
        "title": "Skrumi: проверить без запуска",
        "category": "Skrumi",
        "icon": "$(check)"
      },
      {
        "command": "skrumi.build",
        "title": "Skrumi: собрать приложение",
        "category": "Skrumi",
        "icon": "$(package)"
      },
      {
        "command": "skrumi.chooseEntry",
        "title": "Skrumi: сделать этот файл главным",
        "category": "Skrumi"
      },
      {
        "command": "skrumi.restartServer",
        "title": "Skrumi: Перезапустить языковой сервер (LSP)",
        "category": "Skrumi"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "skrumi.run",
          "when": "editorLangId == skrumi",
          "group": "navigation@0"
        },
        {
          "command": "skrumi.debug",
          "when": "editorLangId == skrumi",
          "group": "navigation@1"
        },
        {
          "command": "skrumi.check",
          "when": "editorLangId == skrumi",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "skrumi.run",
          "when": "editorLangId == skrumi",
          "group": "skrumi@1"
        },
        {
          "command": "skrumi.debug",
          "when": "editorLangId == skrumi",
          "group": "skrumi@1"
        },
        {
          "command": "skrumi.check",
          "when": "editorLangId == skrumi",
          "group": "skrumi@2"
        },
        {
          "command": "skrumi.chooseEntry",
          "when": "editorLangId == skrumi",
          "group": "skrumi@3"
        }
      ],
      "explorer/context": [
        {
          "command": "skrumi.chooseEntry",
          "when": "resourceExtname == .skm",
          "group": "skrumi@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "skrumi.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == skrumi"
      }
    ],
    "taskDefinitions": [
      {
        "type": "skrumi",
        "required": [
          "file"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "check",
              "build"
            ],
            "default": "run",
            "description": "Что сделать: run — запуск, check — проверка, build — standalone-приложение."
          },
          "file": {
            "type": "string",
            "description": "Файл программы относительно папки проекта."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Аргументы программы для run."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "skrumi",
        "owner": "skrumi",
        "source": "skrumi check",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info|hint): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "skrumi-runtime",
        "owner": "skrumi",
        "source": "Skrumi",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": {
          "regexp": "^Skrumi: (.+?):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    ],
    "breakpoints": [
      {
        "language": "skrumi"
      }
    ],
    "debuggers": [
      {
        "type": "skrumi",
        "label": "Skrumi",
        "languages": [
          "skrumi"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Главный файл программы .skm.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Аргументы программы (os_args()).",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Рабочая папка программы. По умолчанию — папка главного файла."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Остановиться на первом операторе программы.",
                "default": false
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Дополнительные переменные окружения программы.",
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "skrumi",
            "request": "launch",
            "name": "Skrumi: текущий файл",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Skrumi: отладка программы",
            "description": "Запуск программы Skrumi под отладчиком",
            "body": {
              "type": "skrumi",
              "request": "launch",
              "name": "Skrumi: ${1:main.skm}",
              "program": "^\"\\${workspaceFolder}/${1:main.skm}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ]
  }
}
