// Skrumi regression: array<T> and map<string, T>
void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. Declaration converts, writes are checked
array<int> scores = [1, to_int(2.9), 3];
assert_true(scores == [1, 2, 3], "elements convert on declaration");
push(scores, to_int(4.7));
scores[0] = to_int(10.2);
insert(scores, 0, 0);
set(scores, 1, 11);
assert_true(scores == [0, 11, 2, 3, 4], "push, index, insert and set convert");
map<string, float> prices = {"tea": 3};
prices["cake"] = 4;
prices.pie = 2;
assert_true(type_of(prices["tea"]) == "float" && type_of(prices.pie) == "float", "map values convert");

// 2. Empty, sized, resized, nullable, nested
array<string> names;
push(names, 7);
assert_true(names == ["7"], "an empty typed array converts too");
array<int> zeros; resize(zeros, 3);
assert_true(zeros == [0, 0, 0], "a sized typed array");
struct Point { int x; }
array<Point> points;
resize(points, 2);
points[0].x = 5;
assert_true(points[1].x == 0, "resize gives each element its own value");
array<int>? maybe;
assert_true(maybe == null, "a nullable typed array starts as null");
maybe = [to_int(1.5)];
assert_true(maybe == [1], "and converts when set");
array<array<int>> grid = [[1], [to_int(2.5)]];
push(grid[0], to_int(3.9));
assert_true(grid == [[1, 3], [2]], "nested typed arrays");
map<string, array<string>> tags = {"fox": ["red"]};
push(tags["fox"], 1);
assert_true(tags["fox"] == ["red", "1"], "a map of typed arrays");

// 3. Parameters, results, fields
int total(array<int> items) {
    int sum = 0;
    for (item in items) { sum += item; }
    return sum;
}
assert_true(total([1, to_int(2.5)]) == 3, "a typed parameter converts a literal");
array<string> labels(int count) {
    array result;
    for (int i = 0; i < count; i++) { push(result, i); }
    return result;
}
assert_true(labels(2) == ["0", "1"], "a typed result converts");
struct Team { string name; array<string> members; }
Team team = Team("a");
push(team.members, 1);
assert_true(team.members == ["1"], "a typed field");
array<int> copied = copy(scores);
string message = "";
try { push(copied, "x"); } catch (e) { message = e; }
assert_true(str_contains(message, "array<int>"), "copy keeps the element type: " + message);

// 4. Errors
message = "";
try { push(scores, "text"); } catch (e) { message = e; }
assert_true(str_contains(message, "an element of array<int>"), "a wrong element: " + message);
try { prices["x"] = "cheap"; } catch (e) { message = e; }
assert_true(str_contains(message, "a value of map<string,float>"), "a wrong map value: " + message);
array<float> floats = [1.5];
try { array<int> other = floats; } catch (e) { message = e; }
assert_true(str_contains(message, "'array<float>'"), "a differently typed array: " + message);
try { total([1, "a"]); } catch (e) { message = e; }
assert_true(str_contains(message, "parameter 'items'"), "a wrong element in an argument: " + message);

print("test_typed_containers OK");
