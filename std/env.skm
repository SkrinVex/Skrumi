//! Переменные окружения и секреты. При запуске исходника Skrumi сначала читает `.env`
//! рядом со скриптом (standalone-программы `.env` не читают).

/// Значение переменной окружения или пустая строка, если она не задана.
string env(string name) { return env_get(name); }

/// Обязательный секрет: если переменная не задана или пуста, программа завершается с ошибкой.
///
/// ```skrumi
/// string token = secret("TELEGRAM_BOT_TOKEN");
/// ```
string secret(string name) { return env_required(name); }

/// Значение переменной окружения или `fallback`, если она не задана или пуста.
///
/// ```skrumi
/// int port = to_int(env_default("PORT", "8080"));
/// ```
string env_default(string name, string fallback) {
    string value = env_get(name);
    if (value == "") {
        return fallback;
    }
    return value;
}

/// Задаёт переменную окружения текущего процесса. `true` при успехе.
bool set_env(string name, string value) { return env_set(name, value); }

using fs;
using os;

/// Снимок пользовательского PATH для Windows или POSIX login shell.
/// Linux: .bash_profile, если существует, иначе .profile; .zprofile при SHELL=zsh.
/// Результат плана — [backend, destination, before, after]; выполнение отдельно.
array user_path_plan(string directory, bool add) {
    string path = path_absolute(directory);
    if (str_contains(path, "\n") || str_contains(path, "\r") || str_contains(path, ":") && os_platform() != "windows") {
        fail("Environment Error: path cannot be represented in PATH");
    }
    if (os_platform() == "windows") {
        if (str_contains(path, ";")) { fail("Environment Error: semicolon in PATH entry"); }
        array before = env_user_snapshot("Path");
        array parts = str_split(before[2], ";");
        array kept;
        bool found = false;
        string normalized = str_lower(str_replace(path, "/", "\\"));
        for (int i = 0; i < size(parts); i++) {
            string candidate = str_lower(str_replace(parts[i], "/", "\\"));
            while (str_ends_with(candidate, "\\") && str_length(candidate) > 3) { candidate = str_substring(candidate, 0, str_length(candidate) - 1); }
            if (candidate == normalized) { found = true; if (add) { push(kept, parts[i]); } }
            else { push(kept, parts[i]); }
        }
        if (add && !found) {
            if (before[2] == "") { kept = []; }
            array ordered = [path];
            for (int i = 0; i < size(kept); i++) { push(ordered, kept[i]); }
            kept = ordered;
        }
        if ((add && found) || (!add && !found)) { return ["registry", "Path", before, before]; }
        string value = str_join(kept, ";");
        array after = [true, before[1], value];
        if (!before[0]) { after[1] = true; }
        if (value == "") { after = [false, false, ""]; }
        return ["registry", "Path", before, after];
    }
    if (os_platform() != "linux") { fail("Environment Error: persistent PATH is unsupported on this platform"); }
    string home = os_user_dir("home");
    string destination = path_join(home, ".profile");
    string shell = path_name(env_get("SHELL"));
    if (shell == "csh" || shell == "tcsh") { fail("Environment Error: PATH integration supports POSIX login shells and zsh"); }
    if (fs_exists_checked(path_join(home, ".bash_profile"))) { destination = path_join(home, ".bash_profile"); }
    if (shell == "zsh") { destination = path_join(home, ".zprofile"); }
    if (shell == "fish") { destination = path_join(os_user_dir("config"), "fish/conf.d/skrumi-path.fish"); }
    bool existed = fs_exists_checked(destination);
    string content = "";
    string mode = "rw-r--r--";
    if (existed) { content = fs_read_checked(destination); mode = fs_permissions(destination); }
    string quoted = "'" + str_replace(path, "'", "'\"'\"'") + "'";
    string marker = "# Skrumi PATH " + sha256_bytes(path);
    string block = "\n" + marker + "\ncase :\"$PATH\": in\n  *:" + quoted + ":*) ;;\n  *) PATH=" + quoted + ":\"$PATH\"; export PATH ;;\nesac\n" + marker + " end\n";
    if (shell == "fish") {
        quoted = "'" + str_replace(str_replace(path, "\\", "\\\\"), "'", "\\'") + "'";
        block = "\n" + marker + "\nif not contains -- " + quoted + " $PATH\n    set -gx PATH " + quoted + " $PATH\nend\n" + marker + " end\n";
    }
    string after = content;
    if (add && !str_contains(content, block)) { after += block; }
    if (!add) { after = str_replace(content, block, ""); }
    return ["file", destination, [existed, content, mode], [existed || after != "", after, mode]];
}

/// Проверяет форму плана и ограничивает цель пользовательским PATH/login-профилем.
void user_path_validate(array plan) {
    if (size(plan) != 4) { fail("Environment Error: invalid PATH plan"); }
    array before = plan[2]; array after = plan[3];
    if (size(before) != 3 || size(after) != 3) { fail("Environment Error: invalid PATH snapshots"); }
    bool supported = plan[0] == "registry" && os_platform() == "windows" && plan[1] == "Path";
    if (plan[0] == "file" && os_platform() == "linux") {
        string home = os_user_dir("home");
        string destination = path_absolute(plan[1]);
        supported = destination == path_join(home, ".profile") || destination == path_join(home, ".bash_profile") || destination == path_join(home, ".zprofile") || destination == path_join(os_user_dir("config"), "fish/conf.d/skrumi-path.fish");
    }
    if (!supported) { fail("Environment Error: PATH plan targets an unsupported user profile"); }
}

/// Применяет/откатывает план, не перезаписывая обнаруженные сторонние изменения.
/// Повторный вызов безопасен: если желаемый снимок уже установлен, ничего не меняет.
void user_path_apply(array plan, bool reverse) {
    user_path_validate(plan);
    array before = plan[2]; array after = plan[3];
    if (reverse) { before = plan[3]; after = plan[2]; }
    if (json_value(before) == json_value(after)) { return; }
    if (plan[0] == "registry") {
        array current = env_user_snapshot(plan[1]);
        if (json_value(current) == json_value(after)) { return; }
        env_user_compare_exchange(plan[1], before, after); return;
    }
    if (plan[0] != "file") { fail("Environment Error: invalid PATH plan"); }
    bool exists = fs_exists_checked(plan[1]);
    string content = "";
    string mode = after[2];
    if (exists) { content = fs_read_checked(plan[1]); mode = fs_permissions(plan[1]); }
    if (exists == after[0] && content == after[1]) { return; }
    if (exists != before[0] || content != before[1] || exists && mode != before[2]) {
        fail("Environment Error: shell profile changed; preserved: " + plan[1]);
    }
    if (after[0]) {
        if (plan[1] == path_join(os_user_dir("config"), "fish/conf.d/skrumi-path.fish")) { make_dirs_checked(path_parent(plan[1])); }
        fs_write_atomic(plan[1], after[1]);
        if (!fs_set_permissions(plan[1], after[2])) { fail("Environment Error: cannot restore profile permissions"); }
    } else { fs_remove_checked(plan[1]); }
}

/// План удаления только ранее добавленной этим планом записи; прочие правки сохраняются.
array user_path_removal(array installed_plan, string directory) {
    user_path_validate(installed_plan);
    // A no-op add never owned a pre-existing entry and must not remove it later.
    if (json_value(installed_plan[2]) == json_value(installed_plan[3])) { return installed_plan; }
    if (installed_plan[0] == "registry") { return user_path_plan(directory, false); }
    array original = installed_plan[2]; array installed = installed_plan[3];
    if (!str_starts_with(installed[1], original[1])) { fail("Environment Error: invalid installed PATH block"); }
    string block = str_substring(installed[1], str_length(original[1]));
    string path = path_absolute(directory);
    string quoted = "'" + str_replace(path, "'", "'\"'\"'") + "'";
    string marker = "# Skrumi PATH " + sha256_bytes(path);
    string expected = "\n" + marker + "\ncase :\"$PATH\": in\n  *:" + quoted + ":*) ;;\n  *) PATH=" + quoted + ":\"$PATH\"; export PATH ;;\nesac\n" + marker + " end\n";
    if (installed_plan[1] == path_join(os_user_dir("config"), "fish/conf.d/skrumi-path.fish")) {
        quoted = "'" + str_replace(str_replace(path, "\\", "\\\\"), "'", "\\'") + "'";
        expected = "\n" + marker + "\nif not contains -- " + quoted + " $PATH\n    set -gx PATH " + quoted + " $PATH\nend\n" + marker + " end\n";
    }
    if (block != expected) { fail("Environment Error: PATH block does not belong to this directory"); }
    string destination = installed_plan[1];
    bool existed = fs_exists_checked(destination);
    string current = ""; string mode = installed[2];
    if (existed) { current = fs_read_checked(destination); mode = fs_permissions(destination); }
    string after = current;
    if (block != "") { after = str_replace(current, block, ""); }
    return ["file", destination, [existed, current, mode], [existed, after, mode]];
}
