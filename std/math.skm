//! Математические константы и помощники поверх встроенных `sqrt`, `pow`, `sin`, `cos` и других.

/// Число π.
float PI = 3.141592653589793;

/// Основание натурального логарифма e.
float E = 2.718281828459045;

/// Ограничивает число диапазоном от 0 до 1.
float clamp01(float value) {
    return clamp(value, 0.0, 1.0);
}

/// Длина вектора (x, y): корень из суммы квадратов.
///
/// ```skrumi
/// float distance = hypot(bx - px, by - py);
/// ```
float hypot(float x, float y) {
    return sqrt(x * x + y * y);
}

/// Переводит градусы в радианы, которых ждут `sin` и `cos`.
float radians(float degrees) {
    return degrees * PI / 180.0;
}

/// Переводит радианы в градусы.
float degrees(float radians) {
    return radians * 180.0 / PI;
}

/// Линейная интерполяция: `a` при `t = 0`, `b` при `t = 1`.
float lerp(float a, float b, float t) {
    return a + (b - a) * t;
}

/// Знак числа: `-1`, `0` или `1`.
int sign(float value) {
    if (value > 0) {
        return 1;
    }
    if (value < 0) {
        return -1;
    }
    return 0;
}

/// Чётно ли целое число.
bool is_even(int value) {
    return value % 2 == 0;
}

/// Плавная интерполяция 0..1 между edge0 и edge1; совпадающие границы — ошибка.
float smoothstep(float edge0, float edge1, float value) {
    if (edge0 == edge1) { throw "smoothstep edges must differ"; }
    float t = clamp01((value - edge0) / (edge1 - edge0));
    return t * t * (3.0 - 2.0 * t);
}
/// Циклическое значение в полуинтервале [low, high), включая отрицательные входы.
float wrap(float value, float low, float high) {
    if (high <= low) { throw "wrap requires high > low"; }
    float span = high - low;
    return low + ((value - low) % span + span) % span;
}
/// Приближение к target без перескока; delta >= 0.
float move_toward(float value, float target, float delta) {
    if (delta < 0.0) { throw "move_toward delta must be non-negative"; }
    return value < target ? min(value + delta, target) : max(value - delta, target);
}
/// Кратчайшая знаковая разница углов в радианах, [-PI, PI).
float angle_difference(float from, float to) { return wrap(to - from, -PI, PI); }
/// Случайное дробное число в [low, high); использует random_seed.
float random_range(float low, float high) {
    if (high < low) { throw "random_range requires high >= low"; }
    return low + (high - low) * random_float();
}
